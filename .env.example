APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ezsite.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ezsite
DB_USERNAME=postgres
DB_PASSWORD=postgres

TENANCY_RLS_USERNAME=tenancy_rls
TENANCY_RLS_PASSWORD=tenancy_rls_local_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail. `log` writes messages to storage/logs instead of sending them,
# which is what you want locally — read them with `php artisan pail`.
#
# Two things break in production if this stays on `log`: an operator is never
# told an enquiry arrived (App\Jobs\SendLeadEmailsJob), and nobody can reset a
# forgotten panel password. Set MAIL_MAILER=smtp and fill in the four lines
# below to switch it on.
#
# MAIL_FROM_ADDRESS must be an address on a domain whose SPF and DKIM records
# name this sender. Every tenant's mail leaves from it — the site's own identity
# rides in the display name and Reply-To instead (App\Mail\SiteMailIdentity),
# because sending as a customer's own address would fail their SPF and land the
# message in spam. Mail is queued, so a worker has to be running.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=deepseek
AI_FAILOVER_PROVIDER=
AI_VISION_PROVIDER=gemini
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CURATOR_DEFAULT_DISK=public
CURATOR_GLIDE_TOKEN=

STOCK_PHOTOS_ENABLED=false
PEXELS_API_KEY=
